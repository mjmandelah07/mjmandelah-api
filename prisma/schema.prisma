generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
}

enum SaleChannel {
  RETAIL
  WHOLESALE
}

enum SaleStatus {
  COMPLETED
  PARTIAL_RETURN
  RETURNED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

enum StockMovementType {
  INTAKE
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
  VOID
}

enum FileKind {
  PRODUCT_PHOTO
  INTAKE_RECEIPT
  DAMAGE_PHOTO
  RECEIPT_PDF
}

enum ReceiptStatus {
  PENDING
  READY
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales            Sale[]
  returns          Return[]
  damages          DamageReport[]
  intakes          StockIntake[]
  movements        StockMovement[]   @relation("MovementActor")
  customerPayments CustomerPayment[]
}

model StoreProfile {
  id            Int      @id @default(1)
  name          String
  address       String?
  phone         String?
  email         String?
  currency      String   @default("NGN")
  receiptFooter String?
  updatedAt     DateTime @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Supplier {
  id        String         @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  intakes   StockIntake[]
}

model Customer {
  id        String            @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  balance   Decimal           @default(0) @db.Decimal(12, 2)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  sales     Sale[]
  payments  CustomerPayment[]
}

model CustomerPayment {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  amount       Decimal  @db.Decimal(12, 2)
  note         String?
  receivedById String
  receivedBy   User     @relation(fields: [receivedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([customerId])
}

model Product {
  id              String   @id @default(uuid())
  name            String
  sku             String   @unique
  barcode         String?  @unique
  description     String?
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  unit            String   @default("pcs")
  costPrice       Decimal  @default(0) @db.Decimal(12, 2)
  retailPrice     Decimal  @db.Decimal(12, 2)
  wholesalePrice  Decimal  @db.Decimal(12, 2)
  wholesaleMinQty Int      @default(1)
  quantityOnHand  Int      @default(0)
  reorderLevel    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  files       StoredFile[]
  saleItems   SaleItem[]
  movements   StockMovement[]
  damages     DamageReport[]
  intakeItems StockIntakeItem[]

  @@index([categoryId])
  @@index([name])
}

model StoredFile {
  id        String        @id @default(uuid())
  kind      FileKind
  url       String
  publicId  String
  mimeType  String?
  bytes     Int?
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  intakeId  String?
  intake    StockIntake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  damageId  String?
  damage    DamageReport? @relation(fields: [damageId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([productId])
  @@index([damageId])
  @@index([intakeId])
}

model StockIntake {
  id           String             @id @default(uuid())
  reference    String?
  supplierId   String?
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  notes        String?
  receivedById String
  receivedBy   User               @relation(fields: [receivedById], references: [id])
  createdAt    DateTime           @default(now())
  items        StockIntakeItem[]
  files        StoredFile[]

  @@index([createdAt])
}

model StockIntakeItem {
  id        String       @id @default(uuid())
  intakeId  String
  intake    StockIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Decimal      @db.Decimal(12, 2)

  @@index([intakeId])
  @@index([productId])
}

model StockMovement {
  id           String            @id @default(uuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  type         StockMovementType
  quantity     Int
  balanceAfter Int
  note         String?
  referenceId  String?
  createdById  String?
  createdBy    User?             @relation("MovementActor", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([referenceId])
}

model Sale {
  id                 String        @id @default(uuid())
  receiptNumber      String        @unique
  channel            SaleChannel
  status             SaleStatus    @default(COMPLETED)
  paymentMethod      PaymentMethod
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  customerName       String?
  cashierId          String
  cashier            User          @relation(fields: [cashierId], references: [id])
  subtotal           Decimal       @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  taxRate            Decimal       @default(0) @db.Decimal(5, 2)
  tax                Decimal       @default(0) @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  amountPaid         Decimal       @db.Decimal(12, 2)
  changeDue          Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue         Decimal       @default(0) @db.Decimal(12, 2)
  notes              String?
  receiptPdfUrl      String?
  receiptPdfPublicId String?
  receiptStatus      ReceiptStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              SaleItem[]
  returns            Return[]

  @@index([createdAt])
  @@index([channel])
  @@index([cashierId])
  @@index([status])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  sku         String
  quantity    Int
  returnedQty Int     @default(0)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Return {
  id            String       @id @default(uuid())
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id])
  reason        String
  refundAmount  Decimal      @db.Decimal(12, 2)
  processedById String
  processedBy   User         @relation(fields: [processedById], references: [id])
  createdAt     DateTime     @default(now())
  items         ReturnItem[]

  @@index([saleId])
  @@index([createdAt])
}

model ReturnItem {
  id           String  @id @default(uuid())
  returnId     String
  return       Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId   String
  productId    String
  quantity     Int
  refundAmount Decimal @db.Decimal(12, 2)

  @@index([returnId])
}

model DamageReport {
  id           String       @id @default(uuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  quantity     Int
  reason       String
  notes        String?
  reportedById String
  reportedBy   User         @relation(fields: [reportedById], references: [id])
  createdAt    DateTime     @default(now())
  images       StoredFile[]

  @@index([productId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  productId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@index([productId])
}

model Job {
  id        String    @id @default(uuid())
  type      String
  payload   Json
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}

model DailySequence {
  dateKey String @id
  value   Int
}
